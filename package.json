{
  "name": "quire",
  "version": "0.2.1",
  "description": "A calm, local-first macOS workspace for writing and compiling LaTeX.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build:dmg-background": "node scripts/build-dmg-background.cjs",
    "desktop:build": "npm run build && npm run build:dmg-background && electron-builder --mac dmg --arm64 --x64",
    "lint": "eslint",
    "doctor": "npx tsx scripts/doctor.ts"
  },
  "build": {
    "appId": "com.aliiexe.quire",
    "productName": "Quire",
    "artifactName": "Quire-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next"
      },
      {
        "from": ".next/static",
        "to": "next/.next/static"
      },
      {
        "from": "public",
        "to": "next/public"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/brand/quire-mark-dark.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Quire ${version}",
      "icon": "public/brand/quire-mark-dark.png",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 112,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 145,
          "y": 186,
          "type": "file"
        },
        {
          "x": 395,
          "y": 186,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aliiexe",
        "repo": "Quire"
      }
    ]
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@uiw/react-codemirror": "^4.25.11",
    "adm-zip": "^0.6.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
